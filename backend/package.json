{
  "name": "smart-classroom-ai-backend",
  "version": "1.0.0",
  "description": "Node.js/Express backend for Smart Classroom AI — authentication, sessions, and APIs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test:students": "node src/tests/test_students.js",
    "test:enrollment": "node src/tests/test_face_enrollment.js",
    "test:recognition": "node -e \"require('child_process').execSync('../ai-service/.venv/bin/python ../ai-service/test_recognition.py', { stdio: 'inherit' })\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
