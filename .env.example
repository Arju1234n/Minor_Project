# ──────────────────────────────────────────────
# Smart Classroom AI — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ─── MongoDB ───────────────────────────────────
MONGO_URI=mongodb://localhost:27017/smart-classroom-ai

# ─── Backend (Node.js / Express) ───────────────
PORT=5000
JWT_SECRET=change-me-to-a-random-secret-string
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ─── Frontend (React / Vite) ──────────────────
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# ─── AI Service (Python / FastAPI) ─────────────
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# ─── WebRTC STUN / TURN ───────────────────────
# Free Google STUN server (works on same network / simple NATs)
STUN_URL=stun:stun.l.google.com:19302
# For production across strict NATs you need a TURN server:
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# ─── Admin Seed ────────────────────────────────
ADMIN_EMAIL=admin@smartclassroom.ai
ADMIN_PASSWORD=admin123
